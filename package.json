{
  "name": "gymflow-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --testTimeout 15000",
    "library:validate": "vitest run scripts/library/validator.test.ts",
    "media:validate": "vitest run scripts/media/manifest-validator.test.ts",
    "assets:generate": "node scripts/generate-native-assets.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "cap:sync": "node scripts/build-mobile.mjs && cap sync",
    "cap:sync:android": "node scripts/build-mobile.mjs && cap sync android",
    "cap:sync:ios": "node scripts/build-mobile.mjs && cap sync ios",
    "android:sync": "node scripts/build-mobile.mjs && cap sync android",
    "android:open": "cap open android",
    "android:build": "node scripts/android-build.mjs",
    "android:bundle:release": "node scripts/android-bundle-release.mjs",
    "ios:sync": "node scripts/build-mobile.mjs && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.7",
    "@capacitor/file-transfer": "^1.0.12",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "19.1.0",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "react-test-renderer": "19.2.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
